	cd /sdf/home/s/smidd/DAQ/ldmx-firmware/software/daq/build/x86_64-linux/Release && $(MAKE) $(MAKESILENT) -f ldmx/data/server/CMakeFiles/ldmx-data-server.dir/build.make ldmx/data/server/CMakeFiles/ldmx-data-server.dir/TriggerHeader.cc.s
.PHONY : TriggerHeader.cc.s

